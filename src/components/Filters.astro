---
import { postTypes } from '../site';

interface Props { current?: string }
const { current = 'all' } = Astro.props;
const items = [{ key: 'all', label: 'All', path: '/posts/' }, ...Object.entries(postTypes).map(([key, t]) => ({ key, label: t.label, path: t.path }))];
---
<nav class="filters" aria-label="Post types">
  {items.map((item) => <a href={item.path} aria-current={item.key === current ? 'page' : undefined}>{item.label}</a>)}
</nav>
