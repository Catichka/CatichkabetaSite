---
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'apps'> | CollectionEntry<'games'>; action: string }
const { entry, action } = Astro.props;
const { title, url, featured, comingSoon, description } = entry.data;
const label = comingSoon ? 'COMING SOON' : featured ? 'FEATURED' : null;
---
<li class="project-row">
  {label && <span class="badge"><span class="badge-dot"></span>{label}</span>}
  <span class="project-name">
    {url ? <a href={url} tabindex="-1">{title}</a> : title}
    {description && <span class="project-desc">{description}</span>}
  </span>
  {url && <a class="project-action" href={url}>{action}<span class="sr-only">: {title}</span> <span aria-hidden="true">→</span></a>}
</li>
