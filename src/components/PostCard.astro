---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import TypePill from './TypePill.astro';

interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const author = await getEntry(post.data.author);
const date = post.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
---
<a class="card" href={`/blog/${post.id}/`}>
  <TypePill type={post.data.type} />
  <h3>{post.data.title}</h3>
  <p>{post.data.description}</p>
  <span class="meta">{author?.data.name} · {date}</span>
</a>
