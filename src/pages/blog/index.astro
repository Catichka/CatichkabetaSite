---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib';

const posts = await getPosts();
---
<Base title="Blog" description="Ideas, discoveries and notes from the rabbit hole.">
  <div class="wrap page">
    <h1>Blog</h1>
    <p class="lede">Ideas, discoveries and notes from the rabbit hole.</p>
    {posts.length > 0 && <div class="grid">{posts.map((post) => <PostCard post={post} />)}</div>}
  </div>
</Base>
