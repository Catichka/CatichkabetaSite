---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Filters from '../components/Filters.astro';
import { postTypes, type PostType } from '../site';
import { getPosts } from '../lib';

export function getStaticPaths() {
  return Object.keys(postTypes).map((type) => ({ params: { type: postTypes[type as PostType].path.slice(1, -1) }, props: { type } }));
}

const { type } = Astro.props as { type: PostType };
const info = postTypes[type];
const posts = (await getPosts()).filter((p) => p.data.type === type);
---
<Base title={info.label} description={info.blurb}>
  <h1>{info.label}</h1>
  <p class="lede">{info.blurb}</p>
  <Filters current={type} />
  {posts.length ? (
    <div class="grid">{posts.map((post) => <PostCard post={post} />)}</div>
  ) : (
    <p class="muted">Nothing here yet. <a href="/contribute/">Be the first?</a></p>
  )}
</Base>
