---
import Base from '../layouts/Base.astro';
// The owner's private stats. The page itself is public HTML with no numbers in it:
// the numbers come from Supabase only after the owner signs in, and the database
// refuses every other account (see docs/stats/schema.sql).
---
<Base title="Stats" description="Private." private>
  <div class="wrap page stats">
    <p class="eyebrow">SITE OWNER ONLY</p>
    <h1>Stats</h1>

    <section id="state-loading" class="stats-panel"><p class="muted">Checking who you are…</p></section>

    <section id="state-signin" class="stats-panel" hidden>
      <p>Sign in with your email. We'll send you a link that opens this page.</p>
      <form id="signin" class="stats-form">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
        <button class="btn" type="submit">Send me a link</button>
      </form>
      <p id="signin-msg" class="muted" role="status"></p>
    </section>

    <section id="state-denied" class="stats-panel" hidden>
      <p>This account can't see the stats.</p>
      <button class="btn ghost" type="button" data-signout>Sign out</button>
    </section>

    <section id="state-stats" hidden>
      <div class="stats-bar">
        <div class="stats-range" role="group" aria-label="Time range">
          <button type="button" data-days="7">7 days</button>
          <button type="button" data-days="30" aria-pressed="true">30 days</button>
          <button type="button" data-days="90">90 days</button>
        </div>
        <button class="stats-link" type="button" data-refresh>Refresh</button>
        <button class="stats-link" type="button" data-signout>Sign out</button>
      </div>
      <p id="stats-note" class="muted stats-small"></p>
      <div id="stats-body"></div>

      <h2>Your own visits</h2>
      <p class="stats-small muted">Stop your own visits being counted on this device. It works one site at a time, so open each link once on each device you use.</p>
      <p class="stats-small">
        <button class="stats-link" type="button" id="ignore-toggle"></button>
      </p>
      <ul class="stats-small stats-ignore-links">
        <li><a href="https://trexgame.catichkabeta.com/?cb_ignore=1">Don't count me on T-Rex Run!</a></li>
        <li><a href="https://eternity.catichkabeta.com/?cb_ignore=1">Don't count me on A Most Inconvenient Eternity</a></li>
        <li><a href="https://sands.catichkabeta.com/?cb_ignore=1">Don't count me on Sands of Atlantis</a></li>
      </ul>
    </section>
  </div>
</Base>

<style is:global>
  .stats .eyebrow { color: var(--mint); letter-spacing: 0.12em; font-size: 0.8rem; margin: 0 0 6px; }
  .stats h2 { font-size: 1.6rem; margin: 48px 0 6px; }
  .stats h2 .stats-h-note { font-size: 0.95rem; font-weight: 400; color: var(--muted); letter-spacing: 0; margin-left: 8px; }
  .stats-small { font-size: 0.95rem; }
  .stats-panel { max-width: 560px; }
  .stats-form { display: grid; gap: 10px; margin: 16px 0; }
  .stats-form input { font: inherit; color: var(--text); background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; }
  .stats-form .btn { justify-self: start; cursor: pointer; }
  .stats-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin: 12px 0 4px; }
  .stats-range { display: inline-flex; border: 1px solid var(--border); border-radius: 999px; padding: 3px; }
  .stats-range button { font: inherit; font-size: 0.95rem; color: var(--muted); background: none; border: 0; border-radius: 999px; padding: 6px 14px; cursor: pointer; }
  .stats-range button[aria-pressed='true'] { background: var(--lavender); color: var(--bg); }
  .stats-link { font: inherit; font-size: 0.95rem; color: var(--lavender); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .stats-link:hover { color: var(--mint); }
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; margin: 14px 0; }
  .stat-tile { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 14px 16px; display: grid; gap: 2px; }
  .stat-value { font-size: 2rem; font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .stat-label { color: var(--muted); font-size: 0.92rem; line-height: 1.3; }
  .stat-tile small { color: var(--muted); font-size: 0.8rem; line-height: 1.3; }
  .stats-chart { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 14px 16px 10px; margin: 12px 0; }
  .stats-chart-title { display: flex; justify-content: space-between; gap: 12px; font-size: 0.92rem; color: var(--muted); margin-bottom: 6px; }
  .stats-chart svg { width: 100%; height: 120px; display: block; }
  .stats-chart .bar { fill: var(--lavender); }
  .stats-chart .bar.today { fill: var(--mint); }
  .stats-chart .bar:hover { fill: var(--peach); }
  .stats-chart .base { stroke: var(--border); }
  .stats-axis { display: flex; justify-content: space-between; font-size: 0.78rem; color: var(--muted); margin-top: 4px; }
  .stats-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; margin: 10px 0; }
  .stats-table th, .stats-table td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--border); }
  .stats-table th { color: var(--muted); font-weight: 400; }
  .stats-table td.num, .stats-table th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .stats-table td { overflow-wrap: anywhere; }
  .stats-empty { color: var(--muted); font-size: 0.95rem; }
  .stats-ignore-links { padding-left: 1.2em; }
  .stats-cols { display: grid; gap: 0 28px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .stats-cols h3 { font-size: 1.1rem; margin: 18px 0 0; }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { SUPABASE_URL, SUPABASE_KEY } from '../stats-config';

  const sb = createClient(SUPABASE_URL, SUPABASE_KEY, { auth: { persistSession: true, detectSessionInUrl: true, flowType: 'implicit' } });
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector(sel) as T;

  const PRODUCTS = [
    { key: 'trex', name: 'T-Rex Run!', url: 'https://trexgame.catichkabeta.com' },
    { key: 'eternity', name: 'A Most Inconvenient Eternity', url: 'https://eternity.catichkabeta.com' },
    { key: 'sands', name: 'Sands of Atlantis', url: 'https://sands.catichkabeta.com' },
  ];
  const OUTPOST = { key: 'outpost', name: 'Family Outpost 31', url: 'https://outpost.catichkabeta.com' };

  let days = 30;

  function show(state: 'loading' | 'signin' | 'denied' | 'stats') {
    for (const s of ['loading', 'signin', 'denied', 'stats']) $(`#state-${s}`).hidden = s !== state;
  }

  const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const fmt = (n: number) => new Intl.NumberFormat('en-AU').format(n || 0);
  const tile = (label: string, value: number | string, note = '') =>
    `<div class="stat-tile"><span class="stat-value">${typeof value === 'number' ? fmt(value) : esc(value)}</span><span class="stat-label">${esc(label)}</span>${note ? `<small>${esc(note)}</small>` : ''}</div>`;

  type Row = { day: string; product: string; kind: string; n: number; people: number };
  type Summary = {
    today: string; since: string; first_day: string | null;
    daily: Row[]; totals: Omit<Row, 'day'>[];
    pages: { path: string; n: number; people: number }[];
    clicks: { product: string; n: number; people: number }[];
    outpost: { day: string; updated_at: string; data: Record<string, any> } | null;
  };

  function dayList(since: string, today: string) {
    const out: string[] = [];
    const d = new Date(since + 'T00:00:00Z');
    const end = new Date(today + 'T00:00:00Z');
    while (d <= end) { out.push(d.toISOString().slice(0, 10)); d.setUTCDate(d.getUTCDate() + 1); }
    return out;
  }
  const shortDay = (iso: string) => new Date(iso + 'T00:00:00Z').toLocaleDateString('en-AU', { day: 'numeric', month: 'short', timeZone: 'UTC' });

  function chart(title: string, list: string[], values: number[], unit: string) {
    const max = Math.max(1, ...values);
    const w = 100 / list.length;
    const gap = list.length > 40 ? 0.15 : 0.25;
    const bars = values.map((v, i) => {
      const h = v ? Math.max(1.5, (v / max) * 100) : 0;
      return `<rect class="bar${i === list.length - 1 ? ' today' : ''}" x="${i * w + w * gap / 2}" y="${100 - h}" width="${w * (1 - gap)}" height="${h}"><title>${esc(shortDay(list[i]))}: ${fmt(v)} ${esc(unit)}</title></rect>`;
    }).join('');
    const total = values.reduce((a, b) => a + b, 0);
    return `<figure class="stats-chart"><figcaption class="stats-chart-title"><span>${esc(title)}</span><span>busiest day ${fmt(Math.max(0, ...values))}</span></figcaption>
      <svg viewBox="0 0 100 100" preserveAspectRatio="none" role="img" aria-label="${esc(title)}: ${fmt(total)} ${esc(unit)} over ${list.length} days">${bars}<line class="base" x1="0" y1="100" x2="100" y2="100" vector-effect="non-scaling-stroke" /></svg>
      <div class="stats-axis"><span>${esc(shortDay(list[0]))}</span><span>today</span></div></figure>`;
  }

  function render(s: Summary) {
    const list = dayList(s.since, s.today);
    const yesterday = list[list.length - 2];
    const series = (product: string, kind: string, field: 'n' | 'people') =>
      list.map((d) => s.daily.find((r) => r.day === d && r.product === product && r.kind === kind)?.[field] ?? 0);
    const on = (product: string, kind: string, day: string, field: 'n' | 'people') =>
      s.daily.find((r) => r.day === day && r.product === product && r.kind === kind)?.[field] ?? 0;
    const total = (product: string, kind: string, field: 'n' | 'people') =>
      s.totals.find((r) => r.product === product && r.kind === kind)?.[field] ?? 0;
    const clicks = (key: string) => s.clicks.find((c) => c.product === key)?.n ?? 0;
    const range = `last ${days} days`;

    let html = '';

    // Everything at a glance
    html += `<h2>Today</h2><div class="stat-grid">`;
    html += tile('Website visitors', on('site', 'view', s.today, 'people'), `${fmt(on('site', 'view', s.today, 'n'))} page views`);
    for (const p of PRODUCTS) html += tile(`${p.name} players`, on(p.key, 'view', s.today, 'people'), `${fmt(on(p.key, 'view', yesterday, 'people'))} yesterday`);
    const op = s.outpost?.data;
    html += tile('Outpost people signed in', op ? op.signed_in_now ?? 0 : '–', op ? 'In the last 12 hours' : 'Waiting for Outpost');
    html += `</div>`;

    // Website
    html += `<h2>Website <span class="stats-h-note">catichkabeta.com</span></h2><div class="stat-grid">`;
    html += tile('Visitors', total('site', 'view', 'people'), `Different devices, ${range}`);
    html += tile('Page views', total('site', 'view', 'n'), range);
    html += tile('Clicks to apps and games', total('site', 'click', 'n'), `${fmt(total('site', 'click', 'people'))} different visitors`);
    html += `</div>`;
    html += chart('Visitors each day', list, series('site', 'view', 'people'), 'visitors');
    html += `<div class="stats-cols"><div><h3>Clicks through to each product</h3><table class="stats-table"><thead><tr><th>Product</th><th class="num">Clicks</th><th class="num">Visitors</th></tr></thead><tbody>`;
    for (const p of [...PRODUCTS, OUTPOST]) {
      const c = s.clicks.find((x) => x.product === p.key);
      html += `<tr><td>${esc(p.name)}</td><td class="num">${fmt(c?.n ?? 0)}</td><td class="num">${fmt(c?.people ?? 0)}</td></tr>`;
    }
    html += `</tbody></table></div><div><h3>Most visited pages</h3>`;
    html += s.pages.length
      ? `<table class="stats-table"><thead><tr><th>Page</th><th class="num">Views</th><th class="num">Visitors</th></tr></thead><tbody>${s.pages.map((p) => `<tr><td>${esc(p.path || '/')}</td><td class="num">${fmt(p.n)}</td><td class="num">${fmt(p.people)}</td></tr>`).join('')}</tbody></table>`
      : `<p class="stats-empty">No visits yet.</p>`;
    html += `</div></div>`;

    // Each game
    for (const p of PRODUCTS) {
      html += `<h2>${esc(p.name)} <span class="stats-h-note"><a href="${p.url}">${esc(new URL(p.url).host)}</a></span></h2><div class="stat-grid">`;
      html += tile('Players today', on(p.key, 'view', s.today, 'people'));
      html += tile('Players yesterday', on(p.key, 'view', yesterday, 'people'));
      html += tile('Different players', total(p.key, 'view', 'people'), range);
      html += tile('Times opened', total(p.key, 'view', 'n'), range);
      html += tile('Clicks from the website', clicks(p.key), range);
      html += `</div>`;
      html += chart('Players each day', list, series(p.key, 'view', 'people'), 'players');
    }

    // Outpost: totals sent by its own server
    html += `<h2>${esc(OUTPOST.name)} <span class="stats-h-note"><a href="${OUTPOST.url}/operator/stats">full Outpost stats</a></span></h2>`;
    if (op) {
      const r1 = (op.recent || []).find((r: any) => r.days === 1) || {};
      const r7 = (op.recent || []).find((r: any) => r.days === 7) || {};
      const r30 = (op.recent || []).find((r: any) => r.days === 30) || {};
      html += `<div class="stat-grid">`;
      html += tile('People signed up', op.people ?? 0);
      html += tile('Groups', op.groups ?? 0);
      html += tile('Signed in now', op.signed_in_now ?? 0, 'Within the last 12 hours');
      html += tile('People who posted', r1.posters ?? 0, 'Last 24 hours');
      html += tile('People who posted', r7.posters ?? 0, 'Last 7 days');
      html += tile('People who posted', r30.posters ?? 0, 'Last 30 days');
      html += tile('Clicks from the website', clicks('outpost'), range);
      html += `</div><p class="stats-small muted">Outpost counts people who post, not people who only read. Last update ${esc(new Date(s.outpost!.updated_at).toLocaleString('en-AU', { dateStyle: 'medium', timeStyle: 'short' }))}.</p>`;
      const signedIn = list.map((d) => (s as any).outpost_daily?.find((o: any) => o.day === d)?.data?.signed_in_now ?? 0);
      html += chart('People signed in each day (last 12 hours, at the last update)', list, signedIn, 'people');
    } else {
      html += `<div class="stat-grid">${tile('Clicks from the website', clicks('outpost'), range)}</div><p class="stats-empty">Outpost hasn't sent its numbers here yet. Its own page has them: <a href="${OUTPOST.url}/operator/stats">Outpost stats</a>.</p>`;
    }

    $('#stats-body').innerHTML = html;
    const started = s.first_day ? `Counting since ${shortDay(s.first_day)}.` : 'Counting has just started, so numbers will appear as people visit.';
    $('#stats-note').textContent = `${started} Days run on Sydney time. Visitors and players are different devices, so one person on a phone and a laptop counts twice.`;
  }

  async function load() {
    const { data, error } = await sb.rpc('stats_summary', { p_days: days });
    if (error) {
      if (error.code === '42501') { show('denied'); return; }
      $('#stats-body').innerHTML = `<p class="stats-empty">Couldn't load the stats: ${esc(error.message)}. Try Refresh.</p>`;
      show('stats');
      return;
    }
    render(data as Summary);
    show('stats');
  }

  function ignoreLabel() {
    let off = false;
    try { off = localStorage.getItem('cb_ignore') === '1'; } catch {}
    $('#ignore-toggle').textContent = off ? 'This device is not counted on catichkabeta.com. Count it again' : "Don't count this device on catichkabeta.com";
  }
  $('#ignore-toggle').addEventListener('click', () => {
    try { localStorage.setItem('cb_ignore', localStorage.getItem('cb_ignore') === '1' ? '0' : '1'); } catch {}
    ignoreLabel();
  });
  ignoreLabel();

  document.querySelectorAll<HTMLButtonElement>('[data-days]').forEach((b) => b.addEventListener('click', () => {
    days = Number(b.dataset.days);
    document.querySelectorAll('[data-days]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    load();
  }));
  document.querySelectorAll('[data-refresh]').forEach((b) => b.addEventListener('click', load));
  document.querySelectorAll('[data-signout]').forEach((b) => b.addEventListener('click', async () => { await sb.auth.signOut(); show('signin'); }));

  $<HTMLFormElement>('#signin').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = $<HTMLInputElement>('#email').value.trim();
    const msg = $('#signin-msg');
    msg.textContent = 'Sending…';
    const { error } = await sb.auth.signInWithOtp({ email, options: { emailRedirectTo: location.origin + '/stats/' } });
    msg.textContent = error ? `That didn't work: ${error.message}` : 'Check your email for the sign-in link. It opens this page.';
  });

  sb.auth.onAuthStateChange((event, session) => {
    if (event === 'SIGNED_IN' && session) load();
  });
  const { data: { session } } = await sb.auth.getSession();
  if (session) load(); else show('signin');
</script>
