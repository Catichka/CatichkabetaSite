---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Hero3D from '../components/Hero3D.astro';
import { art } from '../site';
import { getPosts } from '../lib';

const posts = (await getPosts()).slice(0, 6);
const projects = await getCollection('projects');
const featured = projects.find((p) => p.data.featured) ?? projects[0];
---
<Base>
  <section class="hero">
    <Hero3D />
    <div class="hero-copy">
      <p class="kicker">// apps · games · ai</p>
      <h1><span class="neon">Friends using AI</span> in interesting ways, sharing what works.</h1>
      <p class="lede">CatichkaBeta is a small studio building apps and games, and a shared notebook for the people we know who are doing interesting things with AI.</p>
      <div class="actions">
        <a class="btn" href="/posts/">Read the latest</a>
        <a class="btn ghost" href="/contribute/">Share something</a>
      </div>
    </div>
    {art.hero && <img class="hero-figure" src={art.hero} alt="" />}
  </section>

  <div class="section-head reveal">
    <h2>Latest</h2>
    <a href="/posts/">Everything →</a>
  </div>
  <div class="grid reveal">
    {posts.map((post) => <PostCard post={post} />)}
  </div>

  {featured && (
    <>
      <div class="section-head reveal">
        <h2>What we're making</h2>
        <a href="/projects/">All projects →</a>
      </div>
      <a class="card reveal" href="/projects/">
        <span class="pill status">{featured.data.status}</span>
        <h3>{featured.data.title}</h3>
        <p>{featured.data.summary}</p>
      </a>
    </>
  )}

  <section class="callout reveal">
    <h2>Using AI in an interesting way?</h2>
    <p class="muted">Send us the trick, the prompt, the snippet or the story. Short is fine.</p>
    <a class="btn" href="/contribute/">How to share</a>
  </section>
</Base>
